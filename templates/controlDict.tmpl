FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         @@n_iter@@;
deltaT          1;

writeControl    timeStep;
writeInterval   @@write_interval@@;
purgeWrite      2;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;

        patches         (airfoil);
        rho             rhoInf;
        rhoInf          1;                  // kinematic solver: p/rho, rho = 1
        liftDir         (@@liftDir@@);
        dragDir         (@@dragDir@@);
        CofR            (0.25 0 0);
        pitchAxis       (0 0 1);
        magUInf         @@U@@;
        lRef            1;                  // chord
        Aref            @@Aref@@;           // chord * span (span = dz of the 1-cell extrusion)
    }

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        patches         (airfoil);
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        patches         (airfoil);
    }
}

